---
import { ProjectCard} from "@/components/astro";
import { SITE_URL } from "@/consts";
import BasePage from "@/layouts/BasePage.astro";
import { getCollection } from "astro:content";
// @ts-ignore
import { localizePath } from "astro-i18next";
import i18next, { t, changeLanguage } from "i18next";

changeLanguage("fr");

const a = (path: string) => t(`page.not_found.${path}`);
const language = (i18next.language || "fr");
const featuredProject = (await getCollection("project")).filter(({ data: project }) => project.isFeatured);
---

<BasePage
  title={a("title")}
  description={a("description")}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    url: localizePath(`${SITE_URL}/404`, language),
    name: a("title"),
    description: a("description"),
  }}
>
  <h1> 
  {a('header')}
  </h1>
  <div>
     {featuredProject.map((data) => <ProjectCard {...data} />)}
  </div>
</BasePage>

<style lang="scss">
  @use "~/media-query" as *;

  body {
    background-color: var(--primary-200);
  }
  main {
    align-items: center;
    padding-inline: 2rem;
  }
  h1 {
    font-size: var(--font-h4);
    font-style: italic;
    text-align: center;
    color: var(--accent-800);
    padding-block: 1rem;
  }

  div {
    display: flex;
    flex-direction: column;
    gap: 32px;
    @include breakpoint(tablet) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }
</style>
